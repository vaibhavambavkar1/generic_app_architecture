# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION EXAMPLE (.env)
# ==============================================================================
# WARNING: NEVER commit the actual .env file to version control (Git).
# This is just a template. Copy this file to '.env' and replace the values 
# with your actual production secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production, DEBUG MUST ALWAYS BE False to prevent leaking sensitive tracebacks
DEBUG=False

# Generate a complex, random 50-character string for production.
# You can generate one via python: `import secrets; print(secrets.token_urlsafe(50))`
SECRET_KEY=replace_this_with_a_highly_secure_random_string_for_production

# Comma-separated list of domain names your Django site can serve.
# Example: erp.mycompany.com,www.mycompany.com
ALLOWED_HOSTS=127.0.0.1,localhost,your_production_domain.com

# Required for HTMX and standard forms if sitting behind a proxy/load balancer
# Example: https://erp.mycompany.com
CSRF_TRUSTED_ORIGINS=https://your_production_domain.com


# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (MySQL / PostgreSQL)
# ------------------------------------------------------------------------------
# If migrating to PostgreSQL, change DB_ENGINE to django.db.backends.postgresql
DB_ENGINE=django.db.backends.mysql
DB_NAME=erp_db
DB_USER=erp_user
DB_PASSWORD=erp_secure_production_password_here
DB_ROOT_PASSWORD=erp_secure_root_password_here
DB_HOST=db
DB_PORT=3306


# ------------------------------------------------------------------------------
# REDIS & BACKGROUND JOBS (Celery)
# ------------------------------------------------------------------------------
# Connection string for the Redis instance used by Celery and Django Cache
# Format: redis://[password]@[host]:[port]/[db_number]
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ------------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP for Alerts & Triggers)
# ------------------------------------------------------------------------------
# Use services like AWS SES, SendGrid, Mailgun, or standard GSuite SMTP
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your_smtp_provider_api_key_here
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=erp-noreply@yourcompany.com


# ------------------------------------------------------------------------------
# FILE STORAGE / MEDIA (Optional for AWS S3 Integration)
# ------------------------------------------------------------------------------
# If you are hosting on multiple load-balanced servers, you must store uploaded
# files (like PDFs and Profile Pictures) on cloud storage, not the local disk.
# USE_S3=True
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_STORAGE_BUCKET_NAME=your-erp-bucket-name
# AWS_S3_REGION_NAME=us-east-1
